{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "agent-dist",
    "rootDir": "."
  },
  "include": ["agent/**/*.ts", "src/lib/**/*.ts"]
}
